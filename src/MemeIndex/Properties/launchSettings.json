{
  "$schema": "https://www.schemastore.org/launchsettings.json",
  "profiles": {
    "web-open-url": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "",
      "commandLineArgs": "--dev -l -w $(ProjectDir)web",
      "workingDirectory": "$(OutDir)",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "web": {
      "commandName": "Project",
      "commandLineArgs": "--dev -l -w $(ProjectDir)web",
      "workingDirectory": "$(OutDir)",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "test": {
      "commandName": "Project",
      "commandLineArgs": "lab --dev -t",
      "workingDirectory": "$(OutDir)"
    },
    "files": {
      "commandName": "Project",
      "commandLineArgs": "lab --dev -P args.txt",
      "workingDirectory": "$(OutDir)"
    },
    "demo": {
      "commandName": "Project",
      "commandLineArgs": "lab --dev -D args.txt",
      "workingDirectory": "$(OutDir)"
    },
    "help": {
      "commandName": "Project",
      "commandLineArgs": "--help",
      "workingDirectory": "$(OutDir)"
    }
  }
}
